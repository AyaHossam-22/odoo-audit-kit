# Copy to .env and fill in. NEVER commit .env.
# Use a staging copy (or a dedicated read-only user) whenever possible.

ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_USER=audit@example.com
# Odoo > Preferences > Account Security > New API Key
ODOO_API_KEY=

# Optional: restrict the audit to one company in a multi-company database
# ODOO_COMPANY_ID=1
